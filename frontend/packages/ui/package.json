{
  "name": "@selfsketch/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/theme.css": "./src/styles/theme.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
