    "test:run": "vitest run --root ../.. --passWithNoTests packages/ui/src"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  }
}
